<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: same rule as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="videos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
